[Unit]
Description=NexCRM Celery Beat Scheduler
After=network.target redis.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nexcrm/backend
EnvironmentFile=/home/ubuntu/nexcrm/backend/.env
ExecStart=/home/ubuntu/nexcrm/backend/.venv/bin/celery \
    -A core \
    beat \
    --loglevel=info \
    --logfile=/var/log/nexcrm/celery-beat.log \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
