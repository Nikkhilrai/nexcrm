# ─── Django ─────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-me-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ───────────────────────────────────────────────
# Neon connection string. Leave blank to fall back to SQLite locally.
# Format: postgresql://user:password@ep-xxxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Celery / Redis ─────────────────────────────────────────
# Local Redis (dev). On GCP VM: redis://localhost:6379/0 (Redis runs on same VM)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Email / SMTP (Gmail) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ─── IMAP (Gmail reply polling) ─────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
